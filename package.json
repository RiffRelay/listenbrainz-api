{
  "name": "listenbrainz-api",
  "version": "0.1.1",
  "description": "A fully typed, zero-dependency ListenBrainz REST API client for JavaScript/TypeScript.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "listenbrainz",
    "lastfm",
    "last.fm",
    "scrobble",
    "scrobbling",
    "musicbrainz",
    "music",
    "api",
    "typescript",
    "bun",
    "discord"
  ],
  "license": "GPL-3.0-only",
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "prepare": "bun run build",
    "dev": "bun --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "prepublishOnly": "bun run build && bun run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ListenBrainzBot/listenbrainz-api.git"
  },
  "homepage": "https://github.com/ListenBrainzBot/listenbrainz-api#readme",
  "bugs": {
    "url": "https://github.com/ListenBrainzBot/listenbrainz-api/issues"
  }
}
